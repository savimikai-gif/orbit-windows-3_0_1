<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ORBIT</AssemblyName>
    <RootNamespace>ORBIT</RootNamespace>
    <Version>1.0.0-alpha.1</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <ApplicationIcon>..\Assets\icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <PackageReference Include="System.Speech" Version="10.0.14" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <EmbeddedResource Include="..\Web\index.html" LogicalName="orbit/index.html" />
    <EmbeddedResource Include="..\Web\src\style.css" LogicalName="orbit/src/style.css" />
    <EmbeddedResource Include="..\Web\src\orb.js" LogicalName="orbit/src/orb.js" />
    <EmbeddedResource Include="..\Web\src\commands.js" LogicalName="orbit/src/commands.js" />
    <EmbeddedResource Include="..\Web\src\main.js" LogicalName="orbit/src/main.js" />
    <EmbeddedResource Include="..\Web\src\native-bridge.js" LogicalName="orbit/src/native-bridge.js" />
  </ItemGroup>
</Project>


